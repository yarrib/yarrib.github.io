---
import Base from '../layouts/Base.astro';
import { getPosts, fmtDate } from '../posts';
import { PROJECTS } from '../data/projects';
import ProjectCard from '../components/ProjectCard.astro';
import { RESUME } from '../data/resume';

const dbxCerts = RESUME.certifications.filter((c) => c.featured);

const featured = PROJECTS.filter((p) => p.featured);

const posts = (await getPosts()).slice(0, 5);
---
<Base>
  <h1>Hi, I'm Yarri.</h1>
  <p class="lede">
    I'm an engineer working on data platforms, ML infrastructure and AI agents, mostly on Databricks and Azure.
    I like building tools that make other engineers faster, and I write here about what I learn doing it.
  </p>
  {dbxCerts.length > 0 && (
    <p class="cert-line">
      <span class="cert-badge">Databricks certified</span>
      <a href="/resume/">{dbxCerts.length} Databricks certifications, plus Microsoft Azure →</a>
    </p>
  )}

  <p class="label">Selected work</p>
  <div class="cards">
    {featured.map((p) => <ProjectCard project={p} />)}
  </div>
  <p><a href="/projects/">All projects →</a></p>
  <p class="label">Writing</p>
  {posts.length === 0 ? (
    <p class="empty">First post is on the way.</p>
  ) : (
    <ul class="list">
      {posts.map((p) => (
        <li>
          <div class="row">
            <a class="title" href={`/writing/${p.id}/`}>{p.data.title}</a>
            <time datetime={p.data.date.toISOString()}>{fmtDate(p.data.date)}</time>
          </div>
        </li>
      ))}
    </ul>
  )}

</Base>
