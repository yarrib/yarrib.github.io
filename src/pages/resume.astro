---
import Base from '../layouts/Base.astro';
import { RESUME } from '../data/resume';

const featuredCerts = RESUME.certifications.filter((c) => c.featured);
const otherCerts = RESUME.certifications.filter((c) => !c.featured);
---
<Base title="Resume" description="Experience and education.">
  <h1>Resume</h1>
  <p class="lede">{RESUME.summary}</p>
  {RESUME.pdf && <p><a href={RESUME.pdf}>Download PDF</a></p>}

  {featuredCerts.length > 0 && (
    <>
      <h2>Databricks certifications</h2>
      <div class="cert-grid">
        {featuredCerts.map((c) => (
          <a class="cert" href={c.href}>
            {c.image && <img class="cert-img" src={c.image} alt={`${c.issuer} ${c.name} badge`} width="90" height="120" loading="lazy" />}
            <span class="cert-issuer">{c.issuer}</span>
            <strong>{c.name}</strong>
            <span class="cert-meta">{c.year ? `${c.year} · ` : ''}Verify →</span>
          </a>
        ))}
      </div>
    </>
  )}

  <h2>Experience</h2>
  <ul class="list">
    {RESUME.experience.map((e) => (
      <li>
        <div class="row">
          <span><strong>{e.role}</strong> <span class="muted">· {e.org}</span></span>
          {e.period && <span class="meta">{e.period}</span>}
        </div>
        {e.points.length > 0 && (
          <ul class="points">{e.points.map((p) => <li>{p}</li>)}</ul>
        )}
      </li>
    ))}
  </ul>

  <h2>Education</h2>
  <ul class="list">
    {RESUME.education.map((e) => (
      <li>
        <div class="row">
          <span><strong>{e.degree}</strong> <span class="muted">· {e.school}</span></span>
          <span class="meta">{e.period}</span>
        </div>
      </li>
    ))}
  </ul>

  {otherCerts.length > 0 && (
    <>
      <h2>Other certifications</h2>
      <ul class="list">
        {otherCerts.map((c) => (
          <li>
            <div class="row">
              <span>{c.href ? <a href={c.href}>{c.name}</a> : <strong>{c.name}</strong>} <span class="muted">· {c.issuer}</span></span>
              {c.year && <span class="meta">{c.year}</span>}
            </div>
          </li>
        ))}
      </ul>
    </>
  )}

  <p class="muted" style="margin-top:2rem">See also: <a href="/skills/">Skills</a> · <a href="/projects/">Projects</a></p>
</Base>
